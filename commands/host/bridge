#!/usr/bin/env bash
## Description: Manage the ddev-bridge for sandboxed agents
## Usage: bridge [enable|disable|status|ensure|stop|diff|approve [-y]|list|log [N]|version|update [vX.Y.Z]|policy ls|allow|deny|rm|reset]
## Example: "ddev bridge enable" or "ddev bridge approve" or "ddev bridge update" or "ddev bridge policy deny --reason 'reaches live' ddev get_dump"
## CanRunGlobally: true
set -euo pipefail

# ddev sets DDEV_GLOBAL_DIR for host commands; this script lives in <global dir>/commands/host.
d="${DDEV_GLOBAL_DIR:-$(cd "$(dirname "$0")/../.." && pwd)}"
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) arch=unknown ;; esac
b="$d/ddev-bridge-dist/host/$os-$arch/ddev-bridge"
if [ ! -x "$b" ]; then
  echo "ddev-bridge binary not found at $b; reinstall with install.sh from the ddev-bridge release (see the README)" >&2
  exit 1
fi

root="${DDEV_APPROOT:-$PWD}"
cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  ensure)
    # Also the global post-start hook: starts the bridge only for enabled projects.
    exec "$b" ensure --project "$root" "$@" ;;
  status|stop|list|version)
    exec "$b" "$cmd" "$@" ;;
  enable|disable)
    exec "$b" "$cmd" "$@" "$root" ;;
  diff|register|unregister)
    exec "$b" "$cmd" "$root" ;;
  approve)
    if [ "${1:-}" != "-y" ]; then
      rc=0
      "$b" diff "$root" || rc=$?
      [ "$rc" -eq 0 ] && exit 0
      [ "$rc" -eq 1 ] || exit "$rc"
      read -r -p "Approve these .ddev/ changes for agent use? [y/N] " answer
      case "$answer" in y|Y|yes) ;; *) echo "not approved"; exit 1 ;; esac
    fi
    exec "$b" approve "$root" ;;
  policy)
    sub="${1:-ls}"
    if [ $# -gt 0 ]; then shift; fi
    exec "$b" policy "$sub" --dir "$root" "$@" ;;
  update)
    # Installs a release (default: the latest) like the README's install commands, after checking its sha256.
    releases="${DDEV_BRIDGE_RELEASES:-https://github.com/pvbergen/sbx-ddev-bridge/releases}"
    command -v curl >/dev/null || { echo "update needs curl" >&2; exit 1; }
    tag="${1:-}"
    if [ -z "$tag" ]; then
      latest=$(curl -fsSIL -o /dev/null -w '%{url_effective}' "$releases/latest") ||
        { echo "could not reach $releases/latest" >&2; exit 1; }
      tag="${latest##*/}"
    fi
    if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
      echo "bad release tag '$tag' (expected vX.Y.Z)" >&2; exit 2
    fi
    current=$("$b" version 2>/dev/null || true)
    if [ -z "${1:-}" ] && [ "$current" = "$tag" ]; then
      echo "already at $tag (the latest release); 'ddev bridge update $tag' reinstalls it"; exit 0
    fi
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    echo "downloading $tag (installed: ${current:-unknown})"
    for f in ddev-bridge.tar.gz ddev-bridge.tar.gz.sha256; do
      curl -fsSL -o "$tmp/$f" "$releases/download/$tag/$f" ||
        { echo "could not download $f for $tag" >&2; exit 1; }
    done
    if command -v sha256sum >/dev/null; then sum=$(sha256sum "$tmp/ddev-bridge.tar.gz")
    else sum=$(shasum -a 256 "$tmp/ddev-bridge.tar.gz"); fi
    read -r want _ < "$tmp/ddev-bridge.tar.gz.sha256"
    if [ "${sum%% *}" != "$want" ]; then
      echo "checksum mismatch for ddev-bridge.tar.gz; nothing installed" >&2; exit 1
    fi
    tar -xzf "$tmp/ddev-bridge.tar.gz" -C "$tmp"
    "$tmp/ddev-bridge/install.sh" ;;
  log)
    state="${DDEV_BRIDGE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/ddev-bridge}"
    exec tail -n "${1:-50}" "$state/bridge.log" ;;
  *)
    echo "unknown subcommand '$cmd'; see 'ddev bridge --help'" >&2
    exit 2 ;;
esac
